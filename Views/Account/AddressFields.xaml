<UserControl x:Class="BillyGoat_UI.Views.AddressFields"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             xmlns:services="clr-namespace:BillyGoat_UI.Services">
    <!-- The 11 name and address fields, used for billing and service addresses.
         DataContext is a Models.Address. Used on Contact Information and in Add New Customer. -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:FormField Header="Salutation">
                <ComboBox ItemsSource="{x:Static services:Lookups.Salutations}" SelectedItem="{Binding Salutation}" />
            </views:FormField>
            <views:FormField Grid.Column="1" Header="First name">
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
            </views:FormField>
            <views:FormField Grid.Column="2" Header="Last name">
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
            </views:FormField>
        </Grid>

        <!-- Company, then the street parts in the order they are written. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <views:FormField Header="Company">
                <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
            </views:FormField>
            <views:FormField Grid.Column="1" Header="Street prefix">
                <TextBox Text="{Binding StreetPrefix, UpdateSourceTrigger=PropertyChanged}" />
            </views:FormField>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <views:FormField Header="Street number">
                <TextBox Text="{Binding StreetNumber, UpdateSourceTrigger=PropertyChanged}" />
            </views:FormField>
            <views:FormField Grid.Column="1" Header="Street name">
                <TextBox Text="{Binding StreetName, UpdateSourceTrigger=PropertyChanged}" />
            </views:FormField>
            <views:FormField Grid.Column="2" Header="Street suffix">
                <TextBox Text="{Binding StreetSuffix, UpdateSourceTrigger=PropertyChanged}" />
            </views:FormField>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <views:FormField Header="City">
                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
            </views:FormField>
            <views:FormField Grid.Column="1" Header="State">
                <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" CharacterCasing="Upper" />
            </views:FormField>
            <views:FormField Grid.Column="2" Header="Zip">
                <TextBox Text="{Binding Zip, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" />
            </views:FormField>
        </Grid>
    </StackPanel>
</UserControl>
