<UserControl x:Class="BillyGoat_UI.Views.MarketingLettersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views">
    <!-- DataContext is a MarketingLettersViewModel. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Marketing Letters" Style="{StaticResource HeadingText}" Margin="0,0,0,12" />

        <views:SectionPanel DockPanel.Dock="Top" Header="Prepay and renewal">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:FormField Header="Prepay percent">
                        <TextBox Text="{Binding Account.PrepayPercent, StringFormat=0.##}" />
                    </views:FormField>
                    <views:FormField Grid.Column="1" Header="Renewal letter">
                        <TextBox Text="{Binding Account.RenewalLetter}" />
                    </views:FormField>
                </Grid>
                <TextBlock Style="{StaticResource NoteText}"
                           Text="These fill in automatically when a prepay or renewal letter is printed for this account (Office tab, Print Prepay / Renewal Letters)." />
            </StackPanel>
        </views:SectionPanel>

        <views:SectionPanel Header="Letters sent" Margin="0,18,0,0">
            <DataGrid Style="{StaticResource WideDataGrid}" ItemsSource="{Binding Account.Letters}" AutomationProperties.Name="Letters sent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date sent" Binding="{Binding DateSent, StringFormat=MM/dd/yyyy}" Width="120" />
                    <DataGridTextColumn Header="Letter type" Binding="{Binding LetterType}" Width="150" />
                    <DataGridTextColumn Header="Services" Binding="{Binding Services}" Width="260" />
                    <DataGridTextColumn Header="Prepay %" Binding="{Binding PrepayPercent, StringFormat=0.##}" Width="100" />
                    <DataGridTextColumn Header="Prepay amount" Binding="{Binding PrepayAmount, StringFormat=C2}" Width="140" />
                    <DataGridTextColumn Header="Expires" Binding="{Binding ExpirationDate, StringFormat=MM/dd/yyyy}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </views:SectionPanel>
    </DockPanel>
</UserControl>
