<UserControl x:Class="BillyGoat_UI.Views.StatusChangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             Width="760">
    <!-- DataContext is a StatusChangeViewModel (shown in a DialogWindow). -->
    <UserControl.Resources>
        <!-- A short list of services: "Fertilization round 4   10/06/2026   Printed" -->
        <DataTemplate x:Key="ServiceLine">
            <TextBlock Margin="0,2">
                <Run Text="{Binding ServiceName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="   " />
                <Run Text="{Binding DateScheduled, Mode=OneWay, StringFormat=MM/dd/yyyy}" />
                <Run Text="   " />
                <Run Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Status Change" Style="{StaticResource PageTitleText}" FontSize="24" />
        <TextBlock Text="{Binding AccountText}" Style="{StaticResource SubtitleText}" Margin="0,0,0,14" />

        <!-- Previous status -> new status -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:FormField Header="Previous status">
                <TextBox Style="{StaticResource ReadOnlyTextBox}" Text="{Binding PreviousStatus, Mode=OneWay}" />
            </views:FormField>
            <views:FormField Grid.Column="2" Header="New status">
                <TextBox Style="{StaticResource ReadOnlyTextBox}" Text="{Binding NewStatus, Mode=OneWay}" FontWeight="Bold" />
            </views:FormField>
        </Grid>

        <views:FormField Header="Why are you changing status?">
            <TextBox Style="{StaticResource MultiLineTextBox}" MinHeight="64" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
        </views:FormField>

        <!-- Information box -->
        <Border Style="{StaticResource InfoBox}">
            <StackPanel>
                <TextBlock Text="Information" Style="{StaticResource FieldLabelText}" />
                <TextBlock Text="{Binding InformationText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Outstanding services" Style="{StaticResource FieldLabelText}" />
                <ItemsControl ItemsSource="{Binding OutstandingServices}" ItemTemplate="{StaticResource ServiceLine}" Focusable="False" />
                <TextBlock Text="None" Style="{StaticResource NoteText}"
                           Visibility="{Binding HasOutstandingServices, Converter={StaticResource InverseBoolToVisibility}}" />

                <TextBlock Text="Printed services and requests" Style="{StaticResource FieldLabelText}" Margin="0,12,0,0" />
                <ItemsControl ItemsSource="{Binding PrintedServices}" ItemTemplate="{StaticResource ServiceLine}" Focusable="False" />
                <TextBlock Text="None" Style="{StaticResource NoteText}"
                           Visibility="{Binding HasPrintedServices, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Special payment plans" Style="{StaticResource FieldLabelText}" />
                <TextBlock Text="{Binding PaymentPlanText}" TextWrapping="Wrap" Margin="0,2,0,12" />

                <TextBlock Text="Outstanding balance" Style="{StaticResource FieldLabelText}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <TextBlock Text="{Binding BalanceText}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="_Print" Command="{Binding PrintStatementCommand}" AutomationProperties.Name="Print statement" />
                </StackPanel>

                <!-- Only when re-activating: inactive services that may become active again. -->
                <StackPanel Visibility="{Binding ShowInactiveServices, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Services marked inactive that may become active" Style="{StaticResource FieldLabelText}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding InactiveServices}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />

        <StackPanel Style="{StaticResource DialogButtonRow}">
            <Button Content="_Finish" Style="{StaticResource DialogPrimaryButton}" Command="{Binding FinishCommand}" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
