<UserControl x:Class="BillyGoat_UI.Views.AddCustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             xmlns:vm="clr-namespace:BillyGoat_UI.ViewModels"
             Width="980">
    <!-- DataContext is an AddCustomerViewModel. -->
    <StackPanel>
        <TextBlock Text="Add New Customer" Style="{StaticResource PageTitleText}" FontSize="24" />
        <TextBlock Text="Type the service address, then choose where the bill goes." Style="{StaticResource SubtitleText}" Margin="0,0,0,14" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <views:SectionPanel Header="Service address" VerticalAlignment="Top">
                <views:AddressFields DataContext="{Binding ServiceAddress}" />
            </views:SectionPanel>

            <!-- One group of large radio buttons -->
            <views:SectionPanel Grid.Column="2" Header="Billing address" VerticalAlignment="Top">
                <StackPanel AutomationProperties.Name="Billing address">
                    <RadioButton Style="{StaticResource LargeOptionRadio}" GroupName="BillingChoice" Content="_Same as service address"
                                 IsChecked="{Binding BillingChoice, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:BillingChoice.SameAsService}}" />
                    <RadioButton Style="{StaticResource LargeOptionRadio}" GroupName="BillingChoice" Content="Bill to a _main account"
                                 IsChecked="{Binding BillingChoice, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:BillingChoice.MainAccount}}" />
                    <RadioButton Style="{StaticResource LargeOptionRadio}" GroupName="BillingChoice" Content="Bill to a _corporate account"
                                 IsChecked="{Binding BillingChoice, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:BillingChoice.CorporateAccount}}" />
                    <RadioButton Style="{StaticResource LargeOptionRadio}" GroupName="BillingChoice" Content="Bill to _another address"
                                 IsChecked="{Binding BillingChoice, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:BillingChoice.OtherAddress}}" />

                    <!-- Main / corporate account picker -->
                    <views:FormField Header="{Binding ParentAccountLabel}" Margin="0,8,0,0"
                                     Visibility="{Binding ShowParentAccount, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox ItemsSource="{Binding ParentAccounts}" SelectedItem="{Binding ParentAccount}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding AccountNumber, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding BillingName, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </views:FormField>
                </StackPanel>
            </views:SectionPanel>
        </Grid>

        <!-- Second address, only for "Bill to another address" -->
        <views:SectionPanel Header="Billing address (other)" Margin="0,16,0,0"
                            Visibility="{Binding ShowOtherAddress, Converter={StaticResource BoolToVisibility}}">
            <views:AddressFields DataContext="{Binding OtherBillingAddress}" />
        </views:SectionPanel>

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />

        <StackPanel Style="{StaticResource DialogButtonRow}">
            <Button Content="_OK" Style="{StaticResource DialogPrimaryButton}" Command="{Binding OkCommand}" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
