<UserControl x:Class="BillyGoat_UI.Views.ContactInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views">
    <!-- DataContext is a ContactInfoViewModel. Fields bind straight to Account. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
            <TextBlock Text="Contact Information" Style="{StaticResource HeadingText}" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:SectionPanel Header="Billing information">
                    <views:AddressFields DataContext="{Binding Account.Billing}" />
                </views:SectionPanel>

                <views:SectionPanel Grid.Column="2" Header="Service information">
                    <StackPanel>
                        <views:AddressFields DataContext="{Binding Account.Service}" />
                        <views:FormField Header="Second service name (optional)">
                            <TextBox Text="{Binding Account.SecondServiceName}" />
                        </views:FormField>
                    </StackPanel>
                </views:SectionPanel>
            </Grid>

            <views:SectionPanel Header="Phone information" Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <views:FormField Header="Home phone">
                            <TextBox Text="{Binding Account.HomePhone}" />
                        </views:FormField>
                        <views:FormField Grid.Column="1" Header="Work phone">
                            <TextBox Text="{Binding Account.WorkPhone}" />
                        </views:FormField>
                        <views:FormField Grid.Column="2" Header="Extension">
                            <TextBox Text="{Binding Account.WorkExtension}" />
                        </views:FormField>
                        <views:FormField Grid.Column="3" Header="Mobile number">
                            <TextBox Text="{Binding Account.MobilePhone}" />
                        </views:FormField>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <views:FormField Header="Email address">
                            <TextBox Text="{Binding Account.Email}" />
                        </views:FormField>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Contact" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4" />
                            <WrapPanel AutomationProperties.Name="Contact" Margin="0,6,0,0">
                                <RadioButton GroupName="ContactTitle" Content="Mr"
                                             IsChecked="{Binding Account.ContactTitle, Converter={StaticResource EnumToBool}, ConverterParameter=Mr}" />
                                <RadioButton GroupName="ContactTitle" Content="Mrs"
                                             IsChecked="{Binding Account.ContactTitle, Converter={StaticResource EnumToBool}, ConverterParameter=Mrs}" />
                                <RadioButton GroupName="ContactTitle" Content="Ms"
                                             IsChecked="{Binding Account.ContactTitle, Converter={StaticResource EnumToBool}, ConverterParameter=Ms}" />
                                <RadioButton GroupName="ContactTitle" Content="Other"
                                             IsChecked="{Binding Account.ContactTitle, Converter={StaticResource EnumToBool}, ConverterParameter=Other}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </views:SectionPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
