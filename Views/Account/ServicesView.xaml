<UserControl x:Class="BillyGoat_UI.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             xmlns:vm="clr-namespace:BillyGoat_UI.ViewModels">
    <!-- DataContext is a ServicesViewModel. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Services" Style="{StaticResource HeadingText}" Margin="0,0,0,12" />

        <views:SectionPanel Header="Services for this account">
            <DockPanel>
                <!-- View option bar -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Show" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <RadioButton GroupName="ServiceView" Content="_This year"
                                 IsChecked="{Binding ViewOption, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ServiceViewOption.ThisYear}}" />
                    <RadioButton GroupName="ServiceView" Content="_Last year"
                                 IsChecked="{Binding ViewOption, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ServiceViewOption.LastYear}}" />
                    <RadioButton GroupName="ServiceView" Content="_Future"
                                 IsChecked="{Binding ViewOption, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ServiceViewOption.Future}}" />
                    <RadioButton GroupName="ServiceView" Content="_All"
                                 IsChecked="{Binding ViewOption, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:ServiceViewOption.All}}" />
                </WrapPanel>

                <!-- Buttons (bottom) -->
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="_Print work order" Style="{StaticResource ButtonRowPrimaryButton}" Command="{Binding PrintWorkOrderCommand}" />
                    <Button Content="Add p_rogram" Style="{StaticResource ButtonRowButton}" Command="{Binding AddProgramCommand}" />
                    <Button Content="Add _service" Style="{StaticResource ButtonRowButton}" Command="{Binding AddServiceCommand}" />
                </WrapPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Border DockPanel.Dock="Right" Style="{StaticResource HintBox}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Double-click a service to edit it." FontSize="{StaticResource SmallFontSize}" />
                    </Border>
                    <TextBlock Text="{Binding TotalsText}" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <DataGrid Style="{StaticResource WideDataGrid}"
                          ItemsSource="{Binding Services}"
                          SelectedItem="{Binding SelectedService}"
                          AutomationProperties.Name="Services"
                          views:DataGridOpen.Command="{Binding EditServiceCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Service name" Binding="{Binding ServiceName}" Width="230" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                        <DataGridTextColumn Header="Scheduled" Binding="{Binding DateScheduled, StringFormat=MM/dd/yyyy}" Width="120" />
                        <DataGridTextColumn Header="Sale amount" Binding="{Binding SaleAmount, StringFormat=C2}" Width="120" />
                        <DataGridTextColumn Header="Date printed" Binding="{Binding DatePrinted, StringFormat=MM/dd/yyyy}" Width="120" />
                        <DataGridTextColumn Header="Service ID" Binding="{Binding ServiceId}" Width="100" />
                        <DataGridTextColumn Header="Date completed" Binding="{Binding DateCompleted, StringFormat=MM/dd/yyyy}" Width="140" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C2}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </views:SectionPanel>
    </DockPanel>
</UserControl>
