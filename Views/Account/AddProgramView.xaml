<UserControl x:Class="BillyGoat_UI.Views.AddProgramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             xmlns:services="clr-namespace:BillyGoat_UI.Services"
             Width="820">
    <!-- DataContext is an AddProgramViewModel. -->
    <StackPanel>
        <TextBlock Text="Add Program" Style="{StaticResource PageTitleText}" FontSize="24" />
        <TextBlock Text="{Binding AccountText}" Style="{StaticResource SubtitleText}" Margin="0,0,0,14" />

        <views:SectionPanel Header="Sales information">
            <UniformGrid Columns="3">
                <views:FormField Header="Program">
                    <ComboBox ItemsSource="{x:Static services:Lookups.Programs}" SelectedItem="{Binding Program}" />
                </views:FormField>
                <views:FormField Header="Invoice number">
                    <TextBox Style="{StaticResource ReadOnlyTextBox}" Text="{Binding InvoiceNumber, Mode=OneWay}" />
                </views:FormField>
                <views:FormField Header="Date sold">
                    <DatePicker SelectedDate="{Binding DateSold}" />
                </views:FormField>
                <views:FormField Header="Okayed by">
                    <TextBox Text="{Binding OkayedBy, UpdateSourceTrigger=PropertyChanged}" />
                </views:FormField>
                <views:FormField Header="Source">
                    <ComboBox ItemsSource="{x:Static services:Lookups.Sources}" SelectedItem="{Binding Source}" />
                </views:FormField>
                <views:FormField Header="Service amount, all steps ($)">
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                </views:FormField>
                <views:FormField Header="Status">
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" />
                </views:FormField>
                <views:FormField Header="Measurement (sq ft)">
                    <TextBox Text="{Binding MeasurementText, UpdateSourceTrigger=PropertyChanged}" />
                </views:FormField>
                <views:FormField Header="Salesperson">
                    <ComboBox ItemsSource="{x:Static services:Lookups.Salespeople}" SelectedItem="{Binding Salesperson}" />
                </views:FormField>
            </UniformGrid>
        </views:SectionPanel>

        <views:SectionPanel Header="Routing information" Margin="0,16,0,0">
            <UniformGrid Columns="3">
                <views:FormField Header="Route">
                    <ComboBox ItemsSource="{x:Static services:Lookups.Routes}" SelectedItem="{Binding Route}" />
                </views:FormField>
                <views:FormField Header="Frequency">
                    <ComboBox ItemsSource="{x:Static services:Lookups.Frequencies}" SelectedItem="{Binding Frequency}" />
                </views:FormField>
                <views:FormField Header="Sort">
                    <ComboBox ItemsSource="{x:Static services:Lookups.SortOptions}" SelectedItem="{Binding Sort}" />
                </views:FormField>
            </UniformGrid>
        </views:SectionPanel>

        <!-- What will be created -->
        <Border Style="{StaticResource InfoBox}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Services in this program (scheduled dates)" Style="{StaticResource FieldLabelText}" />
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" />

        <StackPanel Style="{StaticResource DialogButtonRow}">
            <Button Content="_OK" Style="{StaticResource DialogPrimaryButton}" Command="{Binding OkCommand}" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="_Apply" Style="{StaticResource DialogButton}" Command="{Binding ApplyCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
