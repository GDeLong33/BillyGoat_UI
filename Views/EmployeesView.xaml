<UserControl x:Class="BillyGoat_UI.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             xmlns:models="clr-namespace:BillyGoat_UI.Models">
    <!-- DataContext is an EmployeesViewModel (set by the DataTemplate in MainWindow). -->
    <UserControl.Resources>
        <!-- Label / value rows in the "Selected" panel. -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,3,16,3" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <!-- Thin line between sections of the "Selected" panel. -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="0,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Title ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Employees" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Select an employee to see their work, or add a new one." Style="{StaticResource SubtitleText}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ===== Employee list (left) ===== -->
            <views:SectionPanel Grid.Column="0" Header="Employee list">
                <DockPanel>
                    <!-- All / Active / Terminated (bottom) -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <RadioButton GroupName="EmployeeStatus" Content="All employees"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:EmployeeStatusFilter.All}}" />
                        <RadioButton GroupName="EmployeeStatus" Content="Active employees"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:EmployeeStatusFilter.Active}}" />
                        <RadioButton GroupName="EmployeeStatus" Content="Terminated employees"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:EmployeeStatusFilter.Terminated}}" />
                    </WrapPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource HintBox}">
                        <TextBlock Text="Double-click to select your employee." FontSize="{StaticResource SmallFontSize}" />
                    </Border>

                    <DataGrid ItemsSource="{Binding Employees}"
                              SelectedItem="{Binding SelectedEmployee}"
                              AutomationProperties.Name="Employees"
                              PreviewKeyDown="EmployeeGrid_PreviewKeyDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="MouseDoubleClick" Handler="EmployeeRow_DoubleClick" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.3*" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.2*" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.5*" />
                            <DataGridTextColumn Header="MDARD license" Binding="{Binding MdardText}" Width="0.9*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </views:SectionPanel>

            <!-- ===== Right column ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>

                    <!-- Actions -->
                    <views:SectionPanel Header="Actions" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="_Open" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" />
                                <Button Grid.Column="2" Content="_Add" Command="{Binding AddCommand}" />
                                <Button Grid.Column="4" Content="E_xit" Command="{Binding ExitCommand}" />
                            </Grid>
                            <Button Content="Employee _time cards" Command="{Binding TimeCardsCommand}" Margin="0,0,0,10" />
                            <Button Content="Employee _report" Command="{Binding ReportCommand}" />
                        </StackPanel>
                    </views:SectionPanel>

                    <!-- Selected employee details -->
                    <views:SectionPanel Header="{Binding SelectedHeader}">
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="ID" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEmployee.Id}" Style="{StaticResource DetailValue}" />
                                <TextBlock Grid.Row="1" Text="Title" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEmployee.Title}" Style="{StaticResource DetailValue}" />
                                <TextBlock Grid.Row="2" Text="MDARD license" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEmployee.MdardText}" Style="{StaticResource DetailValue}" />
                                <TextBlock Grid.Row="3" Text="Status" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEmployee.StatusText}" Style="{StaticResource DetailValue}" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <!-- This week: three small stat boxes -->
                            <TextBlock Text="This week" Style="{StaticResource FieldLabelText}" Margin="0,0,0,8" />
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource StatBox}" MinWidth="0" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Stops" Style="{StaticResource StatLabelText}" />
                                        <TextBlock Text="{Binding SelectedEmployee.StopsThisWeek}" Style="{StaticResource StatValueText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatBox}" MinWidth="0" Padding="8,6" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="Dollar amount" Style="{StaticResource StatLabelText}" />
                                        <TextBlock Text="{Binding SelectedEmployee.DollarsText}" Style="{StaticResource StatValueText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatBox}" MinWidth="0" Padding="8,6" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Avg per stop" Style="{StaticResource StatLabelText}" />
                                        <TextBlock Text="{Binding SelectedEmployee.AveragePerStopText}" Style="{StaticResource StatValueText}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Divider}" />

                            <!-- Today's time card -->
                            <TextBlock Text="Today's time card" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Time in / out" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEmployee.TimeInOutText}" Style="{StaticResource DetailValue}" />
                                <TextBlock Grid.Row="1" Text="Vehicle mileage" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEmployee.MileageText}" Style="{StaticResource DetailValue}" />
                            </Grid>
                        </StackPanel>
                    </views:SectionPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
