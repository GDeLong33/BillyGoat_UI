<UserControl x:Class="BillyGoat_UI.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             xmlns:models="clr-namespace:BillyGoat_UI.Models">
    <!-- DataContext is a WelcomeViewModel (set by the DataTemplate in MainWindow). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- title + stat boxes -->
            <RowDefinition Height="*" />     <!-- panels -->
        </Grid.RowDefinitions>

        <!-- ===== Title, subtitle and stat boxes ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Welcome" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleText}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Style="{StaticResource StatBox}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Earned today" Style="{StaticResource StatLabelText}" />
                        <TextBlock Text="{Binding EarnedToday}" Style="{StaticResource StatValueText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatBox}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Past due" Style="{StaticResource StatLabelText}" />
                        <TextBlock Text="{Binding PastDue}" Style="{StaticResource StatValueText}"
                                   Foreground="{StaticResource PastDueBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="Applications due this week" Style="{StaticResource StatLabelText}" />
                        <TextBlock Text="{Binding ApplicationsDueThisWeek}" Style="{StaticResource StatValueText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===== Two columns: customer lookup (left) and letters + reports (right, 380 px) ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ===== 1. Customer lookup ===== -->
            <views:SectionPanel Grid.Column="0" Number="1" Header="Customer lookup">
                <DockPanel>
                    <!-- "Search by" radio buttons -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Search by" Style="{StaticResource FieldLabelText}"
                                   VerticalAlignment="Center" Margin="0,0,18,0" />
                        <RadioButton GroupName="CustomerSearchBy" Content="_Last name"
                                     IsChecked="{Binding SearchField, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CustomerSearchField.LastName}}" />
                        <RadioButton GroupName="CustomerSearchBy" Content="_First name"
                                     IsChecked="{Binding SearchField, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CustomerSearchField.FirstName}}" />
                        <RadioButton GroupName="CustomerSearchBy" Content="Customer _number"
                                     IsChecked="{Binding SearchField, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CustomerSearchField.CustomerNumber}}" />
                        <RadioButton GroupName="CustomerSearchBy" Content="Street a_ddress"
                                     IsChecked="{Binding SearchField, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CustomerSearchField.StreetAddress}}" />
                    </WrapPanel>

                    <!-- Search box + Search button -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search text"
                                 AutomationProperties.HelpText="{Binding SearchHint}">
                            <!-- Pressing Enter in the box runs the search. -->
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Grey hint text, only visible while the box is empty. -->
                        <TextBlock Text="{Binding SearchHint}" IsHitTestVisible="False"
                                   Margin="11,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="1" Content="_Search" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SearchCommand}" Margin="10,0,0,0" MinWidth="110" />
                    </Grid>

                    <!-- Active / All / Inactive (bottom) -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <RadioButton GroupName="CustomerStatus" Content="Active customers"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CustomerStatusFilter.Active}}" />
                        <RadioButton GroupName="CustomerStatus" Content="All customers"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CustomerStatusFilter.All}}" />
                        <RadioButton GroupName="CustomerStatus" Content="Inactive customers"
                                     IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CustomerStatusFilter.Inactive}}" />
                    </WrapPanel>

                    <!-- Hint under the list -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource HintBox}">
                        <TextBlock Text="Double-click a customer to open the profile." FontSize="{StaticResource SmallFontSize}" />
                    </Border>

                    <!-- The customer list fills the remaining space. -->
                    <DataGrid x:Name="CustomerGrid"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              AutomationProperties.Name="Customers"
                              PreviewKeyDown="CustomerGrid_PreviewKeyDown">
                        <DataGrid.RowStyle>
                            <!-- Same look as every row, plus a double-click handler. -->
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="MouseDoubleClick" Handler="CustomerRow_DoubleClick" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.1*" />
                            <DataGridTextColumn Header="Street address" Binding="{Binding StreetAddress}" Width="1.2*" />
                            <DataGridTextColumn Header="Customer #" Binding="{Binding CustomerNumber}" Width="0.75*" />
                            <DataGridTextColumn Header="Next service" Binding="{Binding NextServiceText}" Width="1.3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </views:SectionPanel>

            <!-- ===== Right column (scrolls if the window is short) ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>

                    <!-- ===== 2. Create prepayment letters ===== -->
                    <views:SectionPanel Number="2" Header="Create prepayment letters" Margin="0,0,0,18">
                        <StackPanel>
                            <Label Content="_Customer" Target="{Binding ElementName=PrepaymentBox}" Margin="0,0,0,6" />
                            <TextBox x:Name="PrepaymentBox" Text="{Binding PrepaymentCustomer, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Customer for prepayment letter" />
                            <TextBlock Style="{StaticResource NoteText}" Margin="0,8,0,14"
                                       Text="Name, address and price information fill in automatically from the customer record." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="_Print letter" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding PrintLetterCommand}" />
                                <Button Grid.Column="2" Content="_Email PDF"
                                        Command="{Binding EmailPdfCommand}" />
                            </Grid>
                        </StackPanel>
                    </views:SectionPanel>

                    <!-- ===== 3. Reporting system ===== -->
                    <views:SectionPanel Number="3" Header="Reporting system">
                        <StackPanel>
                            <Button Style="{StaticResource ReportLinkButton}" Content="Completed production by account"
                                    Command="{Binding OpenReportCommand}" CommandParameter="Completed production by account" />
                            <Button Style="{StaticResource ReportLinkButton}" Content="Production by date, service, employee"
                                    Command="{Binding OpenReportCommand}" CommandParameter="Production by date, service, employee" />
                            <Button Style="{StaticResource ReportLinkButton}" Content="Production totals by employee"
                                    Command="{Binding OpenReportCommand}" CommandParameter="Production totals by employee" />
                            <Button Style="{StaticResource ReportLinkButton}" Content="Production totals by service"
                                    Command="{Binding OpenReportCommand}" CommandParameter="Production totals by service" />
                            <Button Style="{StaticResource ReportLinkButton}" Content="Production due / still open"
                                    Command="{Binding OpenReportCommand}" CommandParameter="Production due / still open" />
                            <Button Style="{StaticResource TextLinkButton}" Content="More reports: payments, invoices, fertilization"
                                    Command="{Binding OpenReportCommand}" CommandParameter="More reports: payments, invoices, fertilization"
                                    Margin="0,4,0,0" />
                        </StackPanel>
                    </views:SectionPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
