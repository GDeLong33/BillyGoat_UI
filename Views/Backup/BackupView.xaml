<UserControl x:Class="BillyGoat_UI.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views">
    <!-- DataContext is a BackupViewModel. -->
    <DockPanel>
        <!-- ===== Title ===== -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Backup &amp; Export" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Back up all data to a folder, restore an earlier backup, or export lists to Excel (CSV)."
                       Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ===== Status (bottom) ===== -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}"
                   Margin="0,14,0,0" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== Backup (left) ===== -->
            <views:SectionPanel Header="Backup">
                <DockPanel>
                    <views:FormField DockPanel.Dock="Top" Header="Backup folder" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="_Browse..." Margin="10,0,0,0"
                                    Command="{Binding BrowseFolderCommand}" AutomationProperties.Name="Browse for backup folder" />
                            <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </views:FormField>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Back _up now" Style="{StaticResource ButtonRowPrimaryButton}" Command="{Binding BackUpNowCommand}" />
                        <Button Content="_Restore selected" Style="{StaticResource ButtonRowButton}" Command="{Binding RestoreCommand}" />
                    </WrapPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Backup history" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedBackup}"
                              AutomationProperties.Name="Backup history">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="1.1*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="0.6*" />
                            <DataGridTextColumn Header="By" Binding="{Binding User}" Width="0.9*" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </views:SectionPanel>

            <!-- ===== Export (right) ===== -->
            <views:SectionPanel Grid.Column="2" Header="Export to Excel (CSV)" VerticalAlignment="Top">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ExportItems}" ItemTemplate="{StaticResource CheckItemTemplate}"
                                  AutomationProperties.Name="What to export" Focusable="False" />
                    <CheckBox Content="Include inactive accounts and terminated employees"
                              IsChecked="{Binding IncludeInactive}" Margin="0,10,0,0" />
                    <Button Content="_Export..." Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}"
                            HorizontalAlignment="Left" MinWidth="110" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource NoteText}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Each checked item is saved as its own .csv file in the folder you choose." />
                </StackPanel>
            </views:SectionPanel>
        </Grid>
    </DockPanel>
</UserControl>
