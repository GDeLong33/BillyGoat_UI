<UserControl x:Class="BillyGoat_UI.Views.CompletedServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views">
    <!-- DataContext is a CompletedServicesViewModel. -->
    <DockPanel>
        <!-- ===== Title + Close ===== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Enter Completed Services" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding Batch.DisplayName, StringFormat='Production batch {0}'}" Style="{StaticResource SubtitleText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="_Close" MinWidth="110" VerticalAlignment="Top" Command="{Binding CloseCommand}" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <!-- Side by side when there is room, otherwise one above the other. -->
                <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToColumns}, ConverterParameter=900}">

                    <!-- ===== Service information ===== -->
                    <views:SectionPanel Header="Service information" Margin="0,0,9,12">
                        <StackPanel>
                            <UniformGrid Columns="3">
                                <views:FormField Header="Batch number">
                                    <TextBox Style="{StaticResource ReadOnlyTextBox}" Text="{Binding Batch.Number, Mode=OneWay}" />
                                </views:FormField>
                                <views:FormField Header="Date completed">
                                    <DatePicker SelectedDate="{Binding DateCompleted}" />
                                </views:FormField>
                                <views:FormField Header="Employee">
                                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}" />
                                </views:FormField>
                            </UniformGrid>
                            <views:FormField Header="Barcode / invoice number">
                                <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" />
                            </views:FormField>
                            <TextBlock Text="{Binding InvoiceInfoText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding SampleInvoicesText}" Style="{StaticResource NoteText}" />
                        </StackPanel>
                    </views:SectionPanel>

                    <!-- ===== Invoice (appears after a valid invoice number) ===== -->
                    <views:SectionPanel Header="Invoice" Margin="9,0,0,12">
                        <Grid>
                            <TextBlock Text="Type or scan an invoice number to see the invoice." Style="{StaticResource NoteText}"
                                       Visibility="{Binding IsInvoiceFound, Converter={StaticResource InverseBoolToVisibility}}" />
                            <StackPanel Visibility="{Binding IsInvoiceFound, Converter={StaticResource BoolToVisibility}}">
                                <UniformGrid Columns="2">
                                    <views:FormField Header="Invoice amount">
                                        <TextBox Style="{StaticResource ReadOnlyTextBox}" Text="{Binding InvoiceAmountText, Mode=OneWay}" />
                                    </views:FormField>
                                    <views:FormField Header="Price adjustment amount">
                                        <TextBox Text="{Binding AdjustmentAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                    </views:FormField>
                                </UniformGrid>
                                <views:FormField Header="Price adjustment description">
                                    <TextBox Text="{Binding AdjustmentDescription, UpdateSourceTrigger=PropertyChanged}" />
                                </views:FormField>
                                <WrapPanel>
                                    <Button Content="Add _estimate" Style="{StaticResource ButtonRowButton}" Command="{Binding AddEstimateCommand}" />
                                    <Button Content="Add _service" Style="{StaticResource ButtonRowButton}" Command="{Binding AddServiceCommand}" />
                                    <Button Content="Add _request" Style="{StaticResource ButtonRowButton}" Command="{Binding AddRequestCommand}" />
                                    <Button Content="_Post" Style="{StaticResource ButtonRowPrimaryButton}" MinWidth="110" Command="{Binding PostCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </views:SectionPanel>
                </UniformGrid>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,12,0,0" />

                <UniformGrid Margin="0,12,0,0" Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToColumns}, ConverterParameter=900}">

                    <!-- ===== Time entry ===== -->
                    <views:SectionPanel Header="Time entry" Margin="0,0,9,12">
                        <UniformGrid Columns="2">
                            <views:FormField Header="Time in (e.g. 8:15 AM)">
                                <TextBox Text="{Binding TimeIn, UpdateSourceTrigger=PropertyChanged}" />
                            </views:FormField>
                            <views:FormField Header="Time out">
                                <TextBox Text="{Binding TimeOut, UpdateSourceTrigger=PropertyChanged}" />
                            </views:FormField>
                        </UniformGrid>
                    </views:SectionPanel>

                    <!-- ===== Material entry ===== -->
                    <views:SectionPanel Header="Material entry" Margin="9,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <views:FormField Header="Material">
                                    <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding Material}" />
                                </views:FormField>
                                <views:FormField Grid.Column="1" Header="Quantity">
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                </views:FormField>
                                <views:FormField Grid.Column="2" Header="Unit">
                                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" />
                                </views:FormField>
                            </Grid>
                            <Button Content="Add _material" HorizontalAlignment="Left" Command="{Binding AddMaterialCommand}" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding MaterialLines}" AutomationProperties.Name="Materials used" MaxHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="2*" />
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*" />
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </views:SectionPanel>
                </UniformGrid>

                <!-- ===== Entered in this batch ===== -->
                <views:SectionPanel Header="Entered in this batch" Margin="0,6,0,0">
                    <DataGrid ItemsSource="{Binding PostedLines}" AutomationProperties.Name="Entered in this batch" MinHeight="90">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountText}" Width="2*" />
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="2*" />
                            <DataGridTextColumn Header="Employee" Binding="{Binding Employee}" Width="1.5*" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C2}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </views:SectionPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
