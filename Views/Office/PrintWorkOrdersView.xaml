<UserControl x:Class="BillyGoat_UI.Views.PrintWorkOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             xmlns:vm="clr-namespace:BillyGoat_UI.ViewModels">
    <!-- DataContext is a PrintWorkOrdersViewModel (3-step wizard). -->
    <UserControl.Resources>
        <!-- Label in the first column of the step 2 table. -->
        <Style x:Key="RangeLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,10" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- ===== Title + Close ===== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Print Work Orders" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding StepText}" Style="{StaticResource SubtitleText}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button Grid.Column="1" Content="_Close" MinWidth="110" VerticalAlignment="Top" Command="{Binding CloseCommand}" />
        </Grid>

        <!-- ===== Back / Next / Find (bottom) ===== -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="&lt; _Back" MinWidth="110" Command="{Binding BackCommand}" />
                <Button Content="_Next &gt;" MinWidth="110" Margin="10,0,0,0" Command="{Binding NextCommand}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Content="_Find and preview" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Command="{Binding FindAndPreviewCommand}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Text="{Binding ResultText}" Style="{StaticResource SuccessText}" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid>
                <!-- ===== Step 1: what to print ===== -->
                <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:SectionPanel Header="Service to print" VerticalAlignment="Top">
                        <StackPanel>
                            <views:FormField Header="Service">
                                <ComboBox ItemsSource="{Binding ServiceChoices}" SelectedItem="{Binding ServiceToPrint}" />
                            </views:FormField>
                            <TextBlock Style="{StaticResource NoteText}"
                                       Text="Only open services of active accounts are printed. &quot;Fertilization&quot; includes every round." />
                        </StackPanel>
                    </views:SectionPanel>
                    <views:SectionPanel Grid.Column="2" Header="Programs">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Check _all" Command="{Binding CheckAllCommand}" />
                                <Button Content="_Uncheck all" Margin="10,0,0,0" Command="{Binding UncheckAllCommand}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Programs}" ItemTemplate="{StaticResource CheckItemTemplate}"
                                          AutomationProperties.Name="Programs" Focusable="False" />
                        </StackPanel>
                    </views:SectionPanel>
                </Grid>

                <!-- ===== Step 2: how to pick the orders (ranges; empty = no limit) ===== -->
                <views:SectionPanel Header="Pick orders by" Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,12"
                                   Text="Leave a box empty for no limit. Text ranges are alphabetical, for example City from &quot;B&quot; to &quot;F&quot;." />
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="1" Text="From" Style="{StaticResource RangeLabel}" />
                            <TextBlock Grid.Column="2" Text="To" Style="{StaticResource RangeLabel}" />

                            <TextBlock Grid.Row="1" Text="Route" Style="{StaticResource RangeLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,14,10"
                                      ItemsSource="{Binding RouteChoices}" SelectedItem="{Binding RouteFrom}" AutomationProperties.Name="Route from" />
                            <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,0,14,10"
                                      ItemsSource="{Binding RouteChoices}" SelectedItem="{Binding RouteTo}" AutomationProperties.Name="Route to" />

                            <TextBlock Grid.Row="2" Text="Amount per route" Style="{StaticResource RangeLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,14,10" Text="{Binding MaxPerRoute, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Amount per route (most work orders per route)" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource NoteText}" VerticalAlignment="Center" Margin="0,0,0,10"
                                       Text="Most work orders per route (empty = all)" />

                            <TextBlock Grid.Row="3" Text="County" Style="{StaticResource RangeLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,14,10" Text="{Binding CountyFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="County from" />
                            <TextBox Grid.Row="3" Grid.Column="2" Margin="0,0,14,10" Text="{Binding CountyTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="County to" />

                            <TextBlock Grid.Row="4" Text="City" Style="{StaticResource RangeLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,14,10" Text="{Binding CityFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="City from" />
                            <TextBox Grid.Row="4" Grid.Column="2" Margin="0,0,14,10" Text="{Binding CityTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="City to" />

                            <TextBlock Grid.Row="5" Text="Zip code" Style="{StaticResource RangeLabel}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,14,10" Text="{Binding ZipFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Zip code from" />
                            <TextBox Grid.Row="5" Grid.Column="2" Margin="0,0,14,10" Text="{Binding ZipTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Zip code to" />

                            <TextBlock Grid.Row="6" Text="Street" Style="{StaticResource RangeLabel}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,14,10" Text="{Binding StreetFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Street from" />
                            <TextBox Grid.Row="6" Grid.Column="2" Margin="0,0,14,10" Text="{Binding StreetTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Street to" />

                            <TextBlock Grid.Row="7" Text="Schedule date" Style="{StaticResource RangeLabel}" />
                            <DatePicker Grid.Row="7" Grid.Column="1" Margin="0,0,14,10" SelectedDate="{Binding ScheduleFrom}" AutomationProperties.Name="Schedule date from" />
                            <DatePicker Grid.Row="7" Grid.Column="2" Margin="0,0,14,10" SelectedDate="{Binding ScheduleTo}" AutomationProperties.Name="Schedule date to" />

                            <TextBlock Grid.Row="8" Text="Priority (sort A to D)" Style="{StaticResource RangeLabel}" TextWrapping="Wrap" />
                            <TextBox Grid.Row="8" Grid.Column="1" Margin="0,0,14,10" Text="{Binding PriorityFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Priority from" />
                            <TextBox Grid.Row="8" Grid.Column="2" Margin="0,0,14,10" Text="{Binding PriorityTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Priority to" />
                        </Grid>
                    </StackPanel>
                </views:SectionPanel>

                <!-- ===== Step 3: sorting ===== -->
                <views:SectionPanel Header="Sort the work orders by" Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left" AutomationProperties.Name="Sort the work orders by">
                        <RadioButton Style="{StaticResource LargeOptionRadio}" GroupName="WorkOrderSort" Content="Route, then schedule date"
                                     IsChecked="{Binding SortBy, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:WorkOrderSort.RouteThenDate}}" />
                        <RadioButton Style="{StaticResource LargeOptionRadio}" GroupName="WorkOrderSort" Content="Schedule date"
                                     IsChecked="{Binding SortBy, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:WorkOrderSort.ScheduleDate}}" />
                        <RadioButton Style="{StaticResource LargeOptionRadio}" GroupName="WorkOrderSort" Content="Zip code"
                                     IsChecked="{Binding SortBy, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:WorkOrderSort.ZipCode}}" />
                        <RadioButton Style="{StaticResource LargeOptionRadio}" GroupName="WorkOrderSort" Content="Street name"
                                     IsChecked="{Binding SortBy, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:WorkOrderSort.StreetName}}" />
                        <RadioButton Style="{StaticResource LargeOptionRadio}" GroupName="WorkOrderSort" Content="Customer name"
                                     IsChecked="{Binding SortBy, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:WorkOrderSort.CustomerName}}" />
                    </StackPanel>
                </views:SectionPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
