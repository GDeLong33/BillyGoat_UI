<UserControl x:Class="BillyGoat_UI.Views.PriceIncreaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views">
    <!-- DataContext is a PriceIncreaseViewModel. -->
    <DockPanel>
        <!-- ===== Title + Close ===== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Service Price Increase" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Raise the price of open services. Accounts with &quot;Hold current prices&quot; are skipped."
                           Style="{StaticResource SubtitleText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="_Close" MinWidth="110" VerticalAlignment="Top" Command="{Binding CloseCommand}" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== Services checklist ===== -->
                    <views:SectionPanel Header="Services">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Check _all" Command="{Binding CheckAllCommand}" Padding="12,0" />
                                <Button Content="_Uncheck all" Margin="8,0,0,0" Command="{Binding UncheckAllCommand}" Padding="12,0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource CheckItemTemplate}"
                                          AutomationProperties.Name="Services" Focusable="False" />
                        </StackPanel>
                    </views:SectionPanel>

                    <!-- ===== Choices ===== -->
                    <views:SectionPanel Grid.Column="2" Header="Which prices to change">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <views:FormField Header="Scheduled from date">
                                    <DatePicker SelectedDate="{Binding FromDate}" />
                                </views:FormField>
                                <views:FormField Header="Scheduled to date">
                                    <DatePicker SelectedDate="{Binding ToDate}" />
                                </views:FormField>
                                <views:FormField Header="Price range to adjust: from ($)">
                                    <TextBox Text="{Binding PriceMin, UpdateSourceTrigger=PropertyChanged}" />
                                </views:FormField>
                                <views:FormField Header="Price range to adjust: to ($)">
                                    <TextBox Text="{Binding PriceMax, UpdateSourceTrigger=PropertyChanged}" />
                                </views:FormField>
                                <views:FormField Header="Prices with start date from">
                                    <DatePicker SelectedDate="{Binding PriceStartFrom}" />
                                </views:FormField>
                                <views:FormField Header="Prices with start date to">
                                    <DatePicker SelectedDate="{Binding PriceStartTo}" />
                                </views:FormField>
                            </UniformGrid>

                            <Border Style="{StaticResource InfoBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <views:FormField Header="Increase amount" Margin="0,0,18,0">
                                        <TextBox Text="{Binding IncreaseText, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" />
                                    </views:FormField>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" AutomationProperties.Name="Increase by">
                                        <RadioButton GroupName="IncreaseKind" Content="Dollars ($)" IsChecked="{Binding IsDollars}" />
                                        <RadioButton GroupName="IncreaseKind" Content="Percent (%)" IsChecked="{Binding IsPercent}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="_Preview changes" Command="{Binding PreviewCommand}" />
                                <Button Content="Appl_y" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="10,0,0,0" Command="{Binding ApplyCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </views:SectionPanel>
                </Grid>

                <!-- ===== Preview of the changes ===== -->
                <views:SectionPanel Header="Services that will change" Margin="0,18,0,0">
                    <DataGrid Style="{StaticResource WideDataGrid}" ItemsSource="{Binding Matches}" AutomationProperties.Name="Services that will change" MinHeight="90">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountText}" Width="240" />
                            <DataGridTextColumn Header="Service" Binding="{Binding Service.ServiceName}" Width="220" />
                            <DataGridTextColumn Header="Scheduled" Binding="{Binding Service.DateScheduled, StringFormat=MM/dd/yyyy}" Width="120" />
                            <DataGridTextColumn Header="Current price" Binding="{Binding Service.SaleAmount, StringFormat=C2}" Width="130" />
                            <DataGridTextColumn Header="New price" Binding="{Binding NewPrice, StringFormat=C2}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </views:SectionPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
