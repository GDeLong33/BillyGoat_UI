<UserControl x:Class="BillyGoat_UI.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views">
    <!-- DataContext is a SetupViewModel. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Setup" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Edit the lists used by the drop-downs everywhere in the program. Changes show up straight away."
                       Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ===== Settings (bottom) ===== -->
        <views:SectionPanel DockPanel.Dock="Bottom" Header="Settings" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Printing paper size" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="Printing paper size" Margin="0,8,0,0">
                        <RadioButton GroupName="PaperSize" Content="Letter"
                                     IsChecked="{Binding Settings.PaperSize, Converter={StaticResource EnumToBool}, ConverterParameter=Letter}" />
                        <RadioButton GroupName="PaperSize" Content="Legal"
                                     IsChecked="{Binding Settings.PaperSize, Converter={StaticResource EnumToBool}, ConverterParameter=Legal}" />
                        <RadioButton GroupName="PaperSize" Content="A4"
                                     IsChecked="{Binding Settings.PaperSize, Converter={StaticResource EnumToBool}, ConverterParameter=A4}" />
                    </StackPanel>
                </StackPanel>
                <views:FormField Grid.Column="2" Header="Company name (printed on every report)" Margin="0">
                    <TextBox Text="{Binding Settings.CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                </views:FormField>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Company logo" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="_Browse..." Command="{Binding BrowseLogoCommand}" AutomationProperties.Name="Browse for company logo" />
                        <TextBlock Text="{Binding Settings.LogoFileName}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </views:SectionPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Custom fields (left) ===== -->
            <views:SectionPanel Header="Custom fields">
                <ListBox ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}" DisplayMemberPath="Name"
                         AutomationProperties.Name="Custom fields" />
            </views:SectionPanel>

            <!-- ===== Items of the selected list (right) ===== -->
            <views:SectionPanel Grid.Column="2" Header="{Binding SelectedList.Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding SelectedList.Items}" SelectedItem="{Binding SelectedItem}"
                             AutomationProperties.Name="{Binding SelectedList.Name}" />
                    <StackPanel Grid.Column="2">
                        <views:FormField Header="Name" Margin="0,0,0,10">
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" />
                        </views:FormField>
                        <Button Content="_Add as new" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,0,10" />
                        <Button Content="Re_name selected" Command="{Binding RenameCommand}" Margin="0,0,0,10" />
                        <Button Content="_Remove selected" Command="{Binding RemoveCommand}" />
                        <TextBlock Style="{StaticResource NoteText}" Margin="0,14,0,0"
                                   Text="Select an item to rename or remove it. To add, type a new name and click Add as new." />
                    </StackPanel>
                </Grid>
            </views:SectionPanel>
        </Grid>
    </DockPanel>
</UserControl>
