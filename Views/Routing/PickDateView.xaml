<UserControl x:Class="BillyGoat_UI.Views.PickDateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             Width="460">
    <!-- DataContext is a PickDateViewModel. -->
    <StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12" />
        <views:FormField Header="New date">
            <DatePicker SelectedDate="{Binding Date}" />
        </views:FormField>
        <StackPanel Style="{StaticResource DialogButtonRow}">
            <Button Content="_OK" Style="{StaticResource DialogPrimaryButton}" Command="{Binding OkCommand}" IsDefault="True" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
