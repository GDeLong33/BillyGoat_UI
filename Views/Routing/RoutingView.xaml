<UserControl x:Class="BillyGoat_UI.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views">
    <!-- DataContext is a RoutingViewModel. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Routing" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Choose a route to see its stops in driving order." Style="{StaticResource SubtitleText}" />
        </StackPanel>

        <!-- The page scrolls when the window is short; MinHeight keeps the stop list a usable size.
             (Inside a ScrollViewer the star sizes still fill the space when the window is tall.) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid MinHeight="620">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Routes (left) ===== -->
            <views:SectionPanel Header="Routes">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <views:FormField Header="Route name" Margin="0,0,0,8">
                            <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" />
                        </views:FormField>
                        <Button Content="Re_name route" Command="{Binding RenameCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}" AutomationProperties.Name="Routes">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Style="{StaticResource NoteText}" FontWeight="Normal"
                                               Text="{Binding StopCountText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </views:SectionPanel>

            <!-- ===== Stops of the selected route (right) ===== -->
            <!-- HeaderStringFormat (not StringFormat) because Header is an object, not a string. -->
            <views:SectionPanel Grid.Column="2" Header="{Binding SelectedRoute.DisplayName}" HeaderStringFormat="Stops on route {0}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StopCountText}" Style="{StaticResource NoteText}" Margin="0,0,0,8" />

                    <!-- Buttons (bottom) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <WrapPanel>
                            <Button Content="Move _up" Style="{StaticResource ButtonRowButton}" Command="{Binding MoveUpCommand}" />
                            <Button Content="Move _down" Style="{StaticResource ButtonRowButton}" Command="{Binding MoveDownCommand}" />
                            <Button Content="_Add customer to route" Style="{StaticResource ButtonRowButton}" Command="{Binding AddCustomerCommand}" />
                            <Button Content="_Remove from route" Style="{StaticResource ButtonRowButton}" Command="{Binding RemoveCommand}" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Move uncompleted work to a _later date" Style="{StaticResource ButtonRowButton}" Command="{Binding MoveWorkCommand}" />
                            <Button Content="_Suggest stop order" Style="{StaticResource ButtonRowButton}" Command="{Binding SuggestOrderCommand}" />
                            <Button Content="_Print all work orders for this route" Style="{StaticResource ButtonRowPrimaryButton}" Command="{Binding PrintRouteCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid Style="{StaticResource WideDataGrid}" ItemsSource="{Binding SelectedRoute.Stops}" SelectedItem="{Binding SelectedStop}"
                              AutomationProperties.Name="Stops">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stop" Binding="{Binding StopNumber}" Width="70" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="180" />
                            <DataGridTextColumn Header="Service address" Binding="{Binding ServiceAddress}" Width="290" />
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="190" />
                            <DataGridTextColumn Header="Scheduled" Binding="{Binding ScheduledDate, StringFormat=MM/dd/yyyy}" Width="120" />
                            <DataGridTextColumn Header="Done" Binding="{Binding DoneText}" Width="80" />
                            <DataGridTextColumn Header="Also on route" Binding="{Binding OtherRoutes}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </views:SectionPanel>
        </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
