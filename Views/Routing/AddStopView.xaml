<UserControl x:Class="BillyGoat_UI.Views.AddStopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillyGoat_UI.Views"
             xmlns:services="clr-namespace:BillyGoat_UI.Services"
             Width="560">
    <!-- DataContext is an AddStopViewModel. -->
    <StackPanel>
        <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitleText}" FontSize="24" TextWrapping="Wrap" Margin="0,0,0,14" />

        <views:FormField Header="Customer">
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Service.DisplayName, Mode=OneWay}" />
                            <Run Text="  -  " />
                            <Run Text="{Binding Service.StreetLine, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </views:FormField>
        <UniformGrid Columns="2">
            <views:FormField Header="Service">
                <ComboBox ItemsSource="{x:Static services:Lookups.Services}" SelectedItem="{Binding ServiceName}" />
            </views:FormField>
            <views:FormField Header="Scheduled date">
                <DatePicker SelectedDate="{Binding ScheduledDate}" />
            </views:FormField>
        </UniformGrid>
        <TextBlock Style="{StaticResource NoteText}" Text="A property can be on more than one route, for example a mowing route and a fertilization route." />

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,8,0,0" />

        <StackPanel Style="{StaticResource DialogButtonRow}">
            <Button Content="_OK" Style="{StaticResource DialogPrimaryButton}" Command="{Binding OkCommand}" IsDefault="True" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
