<Window x:Class="BillyGoat_UI.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000" Height="880" MinWidth="700" MinHeight="500"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource BodyFontSize}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <!-- A simple print preview: the pages of a FlowDocument, plus Print and Close buttons.
         Printing itself uses the standard Windows print dialog. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="_Print..." Style="{StaticResource PrimaryButton}" MinWidth="110" Click="Print_Click" />
                    <Button Content="_Close" MinWidth="110" Margin="10,0,0,0" IsCancel="True" Click="Close_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Print preview" Style="{StaticResource HeadingText}" />
                    <TextBlock x:Name="PageInfo" Style="{StaticResource NoteText}"
                               Text="Use the arrows at the bottom to move between pages." />
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- FlowDocumentPageViewer shows the document one page at a time, with zoom and page buttons. -->
        <FlowDocumentPageViewer x:Name="Viewer" AutomationProperties.Name="Print preview pages" />
    </DockPanel>
</Window>
