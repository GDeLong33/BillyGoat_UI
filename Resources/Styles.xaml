<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:views="clr-namespace:BillyGoat_UI.Views">

    <!-- =====================================================================
         "Classic Refresh" theme for Billy Goat Lawn Care.
         Sections: 1 Colors, 2 Fonts, 3 Text styles, 4 Focus ring,
                   5 Buttons, 6 Inputs, 7 Navigation tabs, 8 Panels,
                   9 Lists (DataGrid), 10 Helpers
         ===================================================================== -->

    <!-- ===== 1. Colors ===== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#DCE3DA" />
    <SolidColorBrush x:Key="TitleGreenBrush"       Color="#163A28" />  <!-- titles, dark text accents -->
    <SolidColorBrush x:Key="RailGreenBrush"        Color="#1E4B34" />  <!-- rail, primary buttons -->
    <SolidColorBrush x:Key="TabInactiveBrush"      Color="#2F6B4B" />
    <SolidColorBrush x:Key="PanelHeaderBrush"      Color="#E6ECE4" />
    <SolidColorBrush x:Key="LineBrush"             Color="#9AA79B" />  <!-- all thin borders -->
    <SolidColorBrush x:Key="TextBrush"             Color="#1B2B21" />
    <SolidColorBrush x:Key="MutedTextBrush"        Color="#4A5B4F" />
    <SolidColorBrush x:Key="SelectedRowBrush"      Color="#CFE5D6" />
    <SolidColorBrush x:Key="ZebraRowBrush"         Color="#F4F7F2" />
    <SolidColorBrush x:Key="PastDueBrush"          Color="#A63A22" />
    <SolidColorBrush x:Key="SecondaryButtonBrush"  Color="#F1F4EF" />
    <SolidColorBrush x:Key="HoverRowBrush"         Color="#E8F1EA" />
    <SolidColorBrush x:Key="HintBackgroundBrush"   Color="#FBF6E2" />
    <SolidColorBrush x:Key="HintBorderBrush"       Color="#C9B66B" />
    <SolidColorBrush x:Key="PanelBrush"            Color="White" />

    <!-- ===== 2. Fonts ===== -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <sys:Double x:Key="BodyFontSize">16</sys:Double>
    <sys:Double x:Key="SmallFontSize">14</sys:Double>
    <sys:Double x:Key="HeadingFontSize">20</sys:Double>
    <sys:Double x:Key="PageTitleFontSize">30</sys:Double>

    <!-- ===== 3. Text styles ===== -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TitleGreenBrush}" />
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HeadingFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TitleGreenBrush}" />
    </Style>

    <!-- Small grey helper text, e.g. notes under an input. -->
    <Style x:Key="NoteText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Bold label used above inputs and for sub-headings inside a panel. -->
    <Style x:Key="FieldLabelText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Label control (gives keyboard access keys like Alt+C) without the default padding. -->
    <Style TargetType="Label">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- ===== 4. Focus ring =====
         Shown around a control when it gets focus from the keyboard (Tab key). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource TitleGreenBrush}"
                               StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 5. Buttons ===== -->

    <!-- Base button: square corners, 44 px minimum height. -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary: dark green fill, white text. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource RailGreenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RailGreenBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TitleGreenBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#0F2A1C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary: light fill, 2 px dark green border. This is also the default for every Button. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RailGreenBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource TitleGreenBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />

    <!-- Report list button: full-width row with a thin border, text on the left. -->
    <Style x:Key="ReportLinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TitleGreenBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RailGreenBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Big menu button with a title and a description (Office tool menu). -->
    <Style x:Key="MenuTileButton" TargetType="Button" BasedOn="{StaticResource ReportLinkButton}">
        <Setter Property="MinHeight" Value="78" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Text link: underlined dark green text that acts like a hyperlink. -->
    <Style x:Key="TextLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TitleGreenBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Background="Transparent" TextDecorations="Underline" Padding="0,4">
                        <ContentPresenter RecognizesAccessKey="True" />
                    </TextBlock>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource RailGreenBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 6. Inputs ===== -->

    <!-- Text box: square, thin border, thicker dark green border when focused. -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TitleGreenBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio button: round outline with a dark green dot when checked. -->
    <Style TargetType="RadioButton">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,4,22,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="White" Stroke="{StaticResource TitleGreenBrush}" StrokeThickness="1.5" />
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource TitleGreenBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only text box: light grey fill so it is clear it cannot be typed in. -->
    <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="{StaticResource ZebraRowBrush}" />
    </Style>

    <!-- Multi-line text box (notes, instructions, directions). -->
    <Style x:Key="MultiLineTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="88" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Password box: same look as a text box. -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TitleGreenBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box: square box that fills dark green with a white tick when checked. -->
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,5,22,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="20" Height="20" VerticalAlignment="Center"
                                Background="White" BorderBrush="{StaticResource TitleGreenBrush}" BorderThickness="1.5">
                            <Path x:Name="Tick" Data="M3,9 L7,13 L14,4" Stroke="White" StrokeThickness="2.5"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource TitleGreenBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderThickness" Value="2.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-down list (ComboBox): square box with a small arrow on the right. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverRowBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="9,0,34,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- The whole box is a toggle button that opens and closes the list. -->
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                                              Data="M0,0 L5,5 L10,0" Stroke="{StaticResource TitleGreenBrush}" StrokeThickness="2" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- The selected item's text. -->
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <!-- Keyboard focus outline. -->
                        <Border x:Name="FocusBorder" BorderBrush="{StaticResource TitleGreenBrush}" BorderThickness="2"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <!-- The drop-down list. -->
                        <Popup Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Date picker: keeps the built-in calendar button, with our sizes and border. -->
    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="Background" Value="White" />
        <Style.Triggers>
            <!-- Visible keyboard focus: thicker dark green border. -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource TitleGreenBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The text part of a date picker: text centered vertically, no "Select a date" watermark. -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="2,0" Focusable="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List box (Setup lists, route list, report list): square rows, green selection. -->
    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverRowBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TitleGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large option button: a radio button drawn as a big bordered box
         (used for "Billing address" choices and wizard options). -->
    <Style x:Key="LargeOptionRadio" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource SecondaryButtonBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,12" MinHeight="52">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Ellipse Fill="White" Stroke="{StaticResource TitleGreenBrush}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="11" Height="11" Fill="{StaticResource TitleGreenBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHeaderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TitleGreenBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- FormField (Views/Controls/FormField.cs): a label above one input. -->
    <Style TargetType="views:FormField">
        <Setter Property="Margin" Value="0,0,14,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:FormField">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource FieldLabelText}"
                                   Margin="0,0,0,4" TextWrapping="Wrap" />
                        <ContentPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 7. Navigation tabs (left rail) =====
         Each tab is a RadioButton, because exactly one tab can be active at a time.
         Inactive: green with white text. Active: white with bold dark green text,
         so it looks joined to the white main panel. -->
    <Style x:Key="NavTabStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="62" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource TabInactiveBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource RailGreenBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <!-- Keyboard focus ring (hidden until the tab is focused with the keyboard). -->
                            <Border x:Name="FocusBorder" Margin="5" BorderThickness="2"
                                    BorderBrush="White" Visibility="Collapsed" />
                            <ContentPresenter Margin="22,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource RailGreenBrush}" />
                        </Trigger>
                        <!-- Listed after IsMouseOver so the active look wins. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PanelBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TitleGreenBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource TitleGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- White underlined link on the dark green rail (e.g. "Sign out"). -->
    <Style x:Key="RailLinkButton" TargetType="Button" BasedOn="{StaticResource TextLinkButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle Margin="-3" Stroke="White" StrokeThickness="2" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SelectedRowBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Account screen sub-menu: a vertical list of light tabs on the left of the account.
         Checked = light green with a dark green bar on the left. -->
    <Style x:Key="SubNavTabStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Foreground" Value="{StaticResource TitleGreenBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource SecondaryButtonBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,1,1">
                        <Grid>
                            <Border x:Name="Bar" Width="5" HorizontalAlignment="Left" Background="Transparent" />
                            <Border x:Name="FocusBorder" Margin="3" BorderThickness="2"
                                    BorderBrush="{StaticResource TitleGreenBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="16,8,10,8" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHeaderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource TitleGreenBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 8. Panels ===== -->

    <!-- SectionPanel (Views/SectionPanel.cs): white box, thin border, light green header bar.
         If Number is set, a small dark green circle with the number appears before the title. -->
    <Style TargetType="views:SectionPanel">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:SectionPanel">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="{StaticResource PanelHeaderBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,10">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="NumberCircle" Width="28" Height="28" CornerRadius="14"
                                            Background="{StaticResource RailGreenBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="{TemplateBinding Number}" Foreground="White"
                                                   FontSize="{StaticResource SmallFontSize}" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.FontSize="{StaticResource HeadingFontSize}"
                                                      TextElement.FontWeight="Bold"
                                                      TextElement.Foreground="{StaticResource TitleGreenBrush}" />
                                </StackPanel>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Number" Value="{x:Null}">
                            <Setter TargetName="NumberCircle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small stat box (e.g. "Earned today  $1,860"). -->
    <Style x:Key="StatBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ZebraRowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinWidth" Value="120" />
    </Style>
    <Style x:Key="StatLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>
    <Style x:Key="StatValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Pale yellow hint box, e.g. "Double-click a customer to open the profile." -->
    <Style x:Key="HintBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HintBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HintBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- ===== 9. Lists (DataGrid) =====
         Read-only lists with a light green header row, zebra rows and a green selected row. -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource ZebraRowBrush}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinRowHeight" Value="40" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- Tab moves into the list once and then out of it; arrow keys move between rows. -->
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    </Style>

    <!-- Wide list: columns keep their width and a horizontal scroll bar appears when needed. -->
    <Style x:Key="WideDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TitleGreenBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverRowBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
            </Trigger>
            <!-- Visible keyboard focus: dark green outline around the focused row. -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource TitleGreenBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Keep the normal dark text on the light green selected row
                 (the built-in style would switch to white text on blue). -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 10. Helpers ===== -->
    <views:EnumToBoolConverter x:Key="EnumToBool" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <views:NullToVisibilityConverter x:Key="NullToVisibility" />

    <!-- Error message text (e.g. wrong password). Hidden while the text is empty. -->
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PastDueBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Success message text (e.g. "Saved"). Hidden while the text is empty. -->
    <Style x:Key="SuccessText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TitleGreenBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Light green information box (e.g. inside the Status Change dialog). -->
    <Style x:Key="InfoBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ZebraRowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Row of dialog buttons at the bottom right (OK / Cancel / Apply). -->
    <Style x:Key="DialogButtonRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>

    <!-- One line of a checklist (Models.CheckItem): a check box with the item's name. -->
    <DataTemplate x:Key="CheckItemTemplate">
        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,3" />
    </DataTemplate>

    <!-- Row of action buttons under a list (left aligned, wraps when narrow). -->
    <Style x:Key="ButtonRowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Margin" Value="0,0,10,10" />
    </Style>
    <Style x:Key="ButtonRowPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Margin" Value="0,0,10,10" />
    </Style>

</ResourceDictionary>
