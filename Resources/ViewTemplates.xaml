<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BillyGoat_UI.ViewModels"
                    xmlns:views="clr-namespace:BillyGoat_UI.Views">

    <!-- =====================================================================
         ViewModel -> View map.
         Each DataTemplate says: "when a ContentControl's Content is this kind of
         ViewModel, show this UserControl". The ViewModel becomes the UserControl's
         DataContext automatically. This is how page switching works: MainViewModel
         only changes CurrentPage, and WPF picks the right view from this list.
         The same list is used for dialogs (Views/Shell/DialogWindow.xaml).
         ===================================================================== -->

    <!-- Shell -->
    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
        <views:LoginView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <views:PlaceholderView />
    </DataTemplate>

    <!-- Search tab and the Account screen -->
    <DataTemplate DataType="{x:Type vm:SearchViewModel}">
        <views:SearchView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountViewModel}">
        <views:AccountView />
    </DataTemplate>

    <!-- Account sub-screens -->
    <DataTemplate DataType="{x:Type vm:ContactInfoViewModel}">
        <views:ContactInfoView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DetailsViewModel}">
        <views:DetailsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NotesViewModel}">
        <views:NotesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
        <views:ServicesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountingDefaultsViewModel}">
        <views:AccountingDefaultsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AdjustmentsViewModel}">
        <views:AdjustmentsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MarketingLettersViewModel}">
        <views:MarketingLettersView />
    </DataTemplate>

    <!-- Account dialogs -->
    <DataTemplate DataType="{x:Type vm:StatusChangeViewModel}">
        <views:StatusChangeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ServiceEditorViewModel}">
        <views:ServiceEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AddProgramViewModel}">
        <views:AddProgramView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AddCustomerViewModel}">
        <views:AddCustomerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RequiredFieldsViewModel}">
        <views:RequiredFieldsView />
    </DataTemplate>

    <!-- Employees tab -->
    <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
        <views:EmployeesView />
    </DataTemplate>

</ResourceDictionary>
